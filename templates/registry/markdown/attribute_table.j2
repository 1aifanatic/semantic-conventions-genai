{% import 'requirement.j2' as requirement %}
{% import 'stability.j2' as stability %}
{% import 'notes.j2' as notes %}
{% import 'attribute_macros.j2' as attrs %}
{% import 'enum_macros.j2' as enums %}
{% import 'sampling_macros.j2' as sampling %}

{# v2 attribute_table: input is a list of attribute objects with `key`, `brief`,
   `requirement_level`, `provenance`, etc. directly inlined. Provenance is null
   for imported attributes; name_with_link reads it to pick the right link. #}
{% macro generate(attributes, attribute_registry_base_url, upstream_docs_base, title, scope) -%}
{%- if attributes | length > 0 -%}
{% if title and title != "Other" and title != "" %}**{{title}}:**{% else %}**Attributes:**{% endif %}

{% for attribute in attributes | attribute_sort %}

<a id="{{ (scope ~ '.' ~ attribute.key) | kebab_case }}"></a>

#### [`{{ attribute.key }}`](#{{ (scope ~ '.' ~ attribute.key) | kebab_case }})

{{ attribute.brief | trim }}

**Stability:** {{ stability.badge(attribute.stability, attribute.deprecated, attribute.brief) | trim }}

**[Requirement level](https://opentelemetry.io/docs/specs/semconv/general/attribute-requirement-level/):** {{ requirement.render({"level": attribute.requirement_level, "name": attribute.key}, notes, true) | trim }}

**Value type:** {{ attrs.type(attribute) }}

**Registry:** {{ attrs.name_with_link(attribute, attribute_registry_base_url, upstream_docs_base) }}
{%- if attrs.note(attribute) | trim %}

{{ attrs.note(attribute) | trim }}
{%- endif %}
{%- if attribute.examples %}

**Examples:**
{%- for example in attribute.examples %}
{%- if example is string and '\n' in example %}

```
{{ example | trim }}
```
{%- else %}

`{{ example }}`
{%- endif %}
{%- endfor %}
{%- endif %}
{%- if attribute.type is mapping %}
{{ enums.table(attribute, notes) }}
{%- endif %}
{%- endfor %}
{{ sampling.snippet(attributes, attribute_registry_base_url, upstream_docs_base) }}
{%- endif %}{% endmacro %}
